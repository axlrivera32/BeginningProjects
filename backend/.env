# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (zero config, file stored locally — works immediately)
# DATABASE_URL=sqlite+aiosqlite:///./nexdefi.db

# Production PostgreSQL (uncomment and fill when you have a Postgres server):
DATABASE_URL=postgresql+asyncpg://postgres:diner_invertido666@localhost/nexdefi

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Falls back to in-memory if Redis is not running
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=nexdefi-jwt-secret-change-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (optional) ──────────────────────────────────────────────────────────
# Leave empty → recovery codes print to terminal console
SENDGRID_API_KEY=
FROM_EMAIL=noreply@nexdefi.app

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
SENTRY_DSN=
